@using SaigonBite.Helpers
@using SaigonBite.Services
@model SaigonBite.ViewModels.MenuItemFormViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = T["Add or Edit Menu Item"].Value;
    ViewData["Active"] = "Menu Items";
}

<h1 class="h3 mb-3">@T["Add or Edit Menu Item"]</h1>

<div class="sb-card">
    <h2 class="h5 mb-3">@(Model.IsEdit ? T["Edit a Menu Item"] : T["Create a Menu Item"])</h2>

    <partial name="_ErrorList" />

    <form method="post" asp-action="@(Model.IsEdit ? "UpdateItem" : "CreateItem")" asp-route-id="@Model.Id">
        <div class="row g-3">
            <div class="col-12 col-md-6">
                <label for="Name" class="form-label">@T["Item Name"]</label>
                <input id="Name" name="Name" value="@Model.Name" class="form-control" maxlength="100" required />
            </div>
            <div class="col-12 col-md-6">
                <label for="BrandId" class="form-label">@T["Brand"]</label>
                <select id="BrandId" name="BrandId" class="form-select" required>
                    <option value="">@T["Choose a brand"]</option>
                    @foreach (BrandInfo b in Model.Brands)
                    {
                        <option value="@b.BrandId" selected="@(Model.BrandId == b.BrandId)">@b.Name (@(b.IsActive ? T["Active"] : T["Inactive"]))</option>
                    }
                </select>
            </div>
            <div class="col-12 col-md-6">
                <label for="Category" class="form-label">@T["Category"]</label>
                <select id="Category" name="Category" class="form-select" required>
                    <option value="">@T["Choose a category"]</option>
                    @foreach (string c in MenuCategories.All)
                    {
                        <option value="@c" selected="@(Model.Category == c)">@T[c]</option>
                    }
                </select>
            </div>
            <div class="col-12 col-md-6">
                <label for="Price" class="form-label">@T["Price (VND)"]</label>
                @* type=number posts 65000 the same way in English and Vietnamese. *@
                <input id="Price" name="Price" type="number" step="1" min="1" class="form-control"
                       value="@(Model.Price.HasValue ? decimal.Truncate(Model.Price.Value).ToString(System.Globalization.CultureInfo.InvariantCulture) : "")" required />
            </div>
            <div class="col-12">
                <div class="form-label">@T["Available for New Orders"]</div>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" name="IsAvailable" id="available" value="true" checked="@Model.IsAvailable" />
                    <label class="form-check-label" for="available">@T["Available"]</label>
                </div>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" name="IsAvailable" id="unavailable" value="false" checked="@(!Model.IsAvailable)" />
                    <label class="form-check-label" for="unavailable">@T["Unavailable"]</label>
                </div>
            </div>
        </div>
        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-sb">@T["Save Menu Item"]</button>
            <a class="btn btn-outline-secondary" asp-action="MenuItems">@T["Cancel"]</a>
        </div>
    </form>
</div>
