@model SaigonBite.ViewModels.LoginViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = T["Sign in to SaigonBite"].Value;
}

<div class="sb-eyebrow">@T["Sign in"]</div>
<h1 class="h4 mb-1">@T["Sign in to SaigonBite"]</h1>
<p class="text-muted">@T["Use your phone number, passport number or staff account."]</p>

<partial name="_ErrorList" />

<form asp-action="Login" method="post" novalidate>
    <input type="hidden" asp-for="ReturnUrl" />
    <div class="mb-3">
        <label asp-for="Identifier" class="form-label">@T["Phone, passport or staff ID"]</label>
        <input asp-for="Identifier" class="form-control form-control-lg" autocomplete="username" autofocus />
    </div>
    <div class="mb-4">
        <label asp-for="Password" class="form-label">@T["Password"]</label>
        <input asp-for="Password" class="form-control form-control-lg" autocomplete="current-password" />
    </div>
    <button type="submit" class="btn btn-sb btn-lg w-100">@T["Sign in"]</button>
</form>

<div class="sb-divider"><span>@T["New to SaigonBite?"]</span></div>

@* Two ways to register, one button each *@
<div class="d-grid gap-2">
    <a class="btn btn-outline-sb" asp-action="RegisterLocal">@T["Register as Local Customer"]</a>
    <a class="btn btn-outline-sb" asp-action="RegisterTourist">@T["Register as Foreign Tourist"]</a>
</div>
