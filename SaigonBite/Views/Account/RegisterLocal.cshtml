@model SaigonBite.ViewModels.RegisterLocalViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = T["Local Customer Registration"].Value;
}

<div class="sb-eyebrow">@T["Local Customer Registration"]</div>
<h1 class="h4 mb-1">@T["Create Local Customer Account"]</h1>
<p class="text-muted">@T["Phone number, password and simulated OTP"]</p>

<partial name="_ErrorList" />

<form asp-action="RegisterLocal" method="post" novalidate>
    <div class="mb-3">
        <label asp-for="FullName" class="form-label">@T["Full Name"]</label>
        <input asp-for="FullName" class="form-control" autocomplete="name" />
    </div>
    <div class="mb-2">
        <label asp-for="PhoneNumber" class="form-label">@T["Vietnamese Mobile Number"]</label>
        <input asp-for="PhoneNumber" class="form-control" inputmode="numeric" autocomplete="tel" />
    </div>
    <div class="sb-hint mb-3">
        @T["10 digits beginning with 03, 05, 07, 08 or 09. The number must be unique."]
    </div>
    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <label asp-for="Password" class="form-label">@T["Password (minimum 8 characters)"]</label>
            <input asp-for="Password" class="form-control" autocomplete="new-password" />
        </div>
        <div class="col-md-6">
            <label asp-for="ConfirmPassword" class="form-label">@T["Confirm Password"]</label>
            <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
        </div>
    </div>
    <button type="submit" class="btn btn-sb w-100">@T["Send OTP and Continue"]</button>
</form>

<div class="mt-3 small text-muted d-flex flex-wrap justify-content-between gap-2">
    <span>@T["Already registered?"] <a href="/Account/Login">@T["Sign in"]</a></span>
    <a asp-action="RegisterTourist">@T["Foreign tourist? Register here"]</a>
</div>
