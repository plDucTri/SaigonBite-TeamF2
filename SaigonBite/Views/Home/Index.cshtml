@model SaigonBite.ViewModels.HomeViewModel
@using SaigonBite.Helpers
@{
    ViewData["Title"] = "Home";
    bool signedIn = User.Identity?.IsAuthenticated == true;
    string role = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "";

    // Each role gets its own layout, so the side menu and the Sign out button are there.
    // A visitor who is not signed in gets the same card layout as the login page.
    Layout = !signedIn ? "_AuthLayout" : role == Roles.Admin ? "_AdminLayout" : "_PortalLayout";
    ViewData["Active"] = "Dashboard";

    // The shortcut cards of each role: title, one-line text, address.
    (string Title, string Text, string Href)[] tiles;
    if (role == Roles.Admin)
    {
        tiles = new[]
        {
            ("User Accounts", "View, edit and deactivate customer and staff accounts.", "/Admin/Accounts"),
            ("Revenue Report R1", "Revenue by brand category and payment method.", "/Admin/Revenue"),
            ("Order Oversight", "Follow every order and its status history.", "/AdminOrders"),
            ("Heavy Rain Flag", "Switch the heavy-rain surcharge on or off.", "/AdminOrders/Simulation")
        };
    }
    else if (role == Roles.Kitchen)
    {
        tiles = new[] { ("Orders at My Hub", "Confirm, prepare and hand over the orders of your hub.", "/KitchenOrders") };
    }
    else if (role == Roles.Shipper)
    {
        tiles = new[] { ("Ready Delivery Jobs", "Accept ready orders and deliver them.", "/ShipperOrders/Jobs") };
    }
    else
    {
        tiles = new[]
        {
            ("Order food", "Pick a hub and build your order.", "/Orders/Menu"),
            ("My Orders", "Track your orders and their status.", "/Orders/MyOrders")
        };
    }
}

@if (signedIn)
{
    <div class="mb-4">
        <div class="sb-eyebrow">@T["Dashboard"]</div>
        <h1 class="h3 mb-2">@T["Welcome back"], @User.Identity?.Name</h1>
        <span class="sb-chip">@T[RoleLabels.For(role)]</span>
    </div>

    @if (role == Roles.Admin)
    {
        @* Numbers of this month, from the account and report services *@
        <div class="row g-3 mb-4">
            <div class="col-6 col-xl-3">
                <div class="sb-card sb-stat h-100">
                    <div class="sb-stat-label">@T["Active accounts"]</div>
                    <div class="sb-stat-value">@Model.ActiveAccounts</div>
                </div>
            </div>
            <div class="col-6 col-xl-3">
                <div class="sb-card sb-stat h-100">
                    <div class="sb-stat-label">@T["Inactive accounts"]</div>
                    <div class="sb-stat-value">@Model.InactiveAccounts</div>
                </div>
            </div>
            <div class="col-6 col-xl-3">
                <div class="sb-card sb-stat h-100">
                    <div class="sb-stat-label">@T["Orders this month"]</div>
                    <div class="sb-stat-value">@Model.OrdersThisMonth</div>
                </div>
            </div>
            <div class="col-6 col-xl-3">
                <div class="sb-card sb-stat h-100">
                    <div class="sb-stat-label">@T["Revenue this month"]</div>
                    <div class="sb-stat-value">@Model.RevenueThisMonth.Vnd()</div>
                </div>
            </div>
        </div>
    }

    <div class="row g-3">
        @foreach (var tile in tiles)
        {
            <div class="col-sm-6">
                <a class="sb-tile" href="@tile.Href">
                    <span class="sb-tile-title">@T[tile.Title]</span>
                    <span class="sb-tile-text">@T[tile.Text]</span>
                    <span class="sb-tile-go" aria-hidden="true">&rarr;</span>
                </a>
            </div>
        }
    </div>
}
else
{
    <div class="sb-eyebrow">SaigonBite</div>
    <h1 class="h4 mb-4">@T["Welcome to SaigonBite"]</h1>

    <div class="d-grid gap-2">
        <a class="btn btn-sb btn-lg" asp-controller="Account" asp-action="Login">@T["Sign in"]</a>
        <a class="btn btn-outline-sb" asp-controller="Account" asp-action="RegisterLocal">@T["Register as Local Customer"]</a>
        <a class="btn btn-outline-sb" asp-controller="Account" asp-action="RegisterTourist">@T["Register as Foreign Tourist"]</a>
    </div>
}
