@{
    ViewData["Title"] = "Access check";
}
<div class="py-4">
    <h1 class="h4 mb-3">@ViewData["Who"] page</h1>
    <p>
        You are signed in as <strong>@User.Identity?.Name</strong>
        (@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value).
        This page is only for: @ViewData["Who"].
    </p>
</div>
