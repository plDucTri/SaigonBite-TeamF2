@* Price breakdown in BR10 order (Figma D03, D04, D08). Model = PricingResult. *@
@using SaigonBite.Helpers
@using SaigonBite.Services
@model PricingResult
<table class="table table-sm mb-0">
    <tbody>
        <tr><td>@T["Item subtotal (S)"]</td><td class="text-end">@Model.Subtotal.Vnd()</td></tr>
        <tr><td>@T["Quiet Kitchen discount (Q)"]</td><td class="text-end">-@Model.QuietDiscount.Vnd()</td></tr>
        <tr><td>@T["Voucher discount (V)"]</td><td class="text-end">-@Model.VoucherDiscount.Vnd()</td></tr>
        <tr class="fw-semibold"><td>@T["Food total (F)"]</td><td class="text-end">@Model.FoodTotal.Vnd()</td></tr>
        <tr><td>@T["Delivery fee (D)"]@(Model.FreeDelivery ? " - " + T["waived (S 300,000+)"].Value : "")</td><td class="text-end">@Model.DeliveryFee.Vnd()</td></tr>
        <tr><td>@T["Rush-hour surcharge (R)"]</td><td class="text-end">@Model.RushSurcharge.Vnd()</td></tr>
        <tr><td>@T["Heavy-rain surcharge (R2)"]</td><td class="text-end">@Model.RainSurcharge.Vnd()</td></tr>
        <tr class="table-success fw-bold"><td>@T["Rounded total"]</td><td class="text-end">@Model.Total.Vnd()</td></tr>
    </tbody>
</table>
