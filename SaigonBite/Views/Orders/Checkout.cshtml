@using SaigonBite.Helpers
@using SaigonBite.ViewModels
@model CheckoutViewModel
@{
    ViewData["Title"] = T["Checkout"].Value;
    ViewData["Active"] = "Checkout";
}

<h2 class="h4 mb-3">@(Model.IsTourist ? T["Checkout - Foreign Tourist"] : T["Checkout - Local Customer"])</h2>

@foreach (var m in Model.Messages)
{
    <div class="alert alert-danger">@T[m]</div>
}
@if (Model.Violations.Count > 0)
{
    <div class="alert alert-warning">
        <strong>@T["This order cannot be placed yet:"]</strong>
        <ul class="mb-0">
            @foreach (var v in Model.Violations)
            {
                <li>@v.Rule: @v.Message @v.Fix</li>
            }
        </ul>
    </div>
}
@foreach (var w in Model.Warnings)
{
    <div class="alert alert-info">@w</div>
}

<form method="post" asp-action="Checkout">
    <div class="row g-3">
        <div class="col-12 col-lg-7">
            <div class="card card-body">
                <h5>@(Model.IsTourist ? T["Hotel Delivery and Payment"] : T["Delivery and Payment"])</h5>
                <p class="text-muted small">
                    @T["Hub: {0} - {1} load", Model.HubName, Model.HubLoadPct.Pct()]@(Model.HubLoadPct < 30 ? " - " + T["Quiet Kitchen eligible."].Value : "")
                </p>

                <div class="mb-3">
                    <label class="form-label" for="DeliveryAddress">@(Model.IsTourist ? T["Hotel or delivery address"] : T["Delivery address"])</label>
                    <input class="form-control" id="DeliveryAddress" name="DeliveryAddress" value="@Model.Form.DeliveryAddress" maxlength="250" />
                </div>
                @if (Model.IsTourist)
                {
                    <div class="mb-3">
                        <label class="form-label" for="RoomNo">@T["Hotel room number"]</label>
                        <input class="form-control" id="RoomNo" name="RoomNo" value="@Model.Form.RoomNo" maxlength="20" />
                    </div>
                }
                <div class="row">
                    <div class="col-6 mb-3">
                        <label class="form-label" for="Distance">@T["Distance from hub (km, max 8.0)"]</label>
                        <input class="form-control" id="Distance" name="Distance" inputmode="decimal" autocomplete="off" value="@Model.Form.Distance" />
                    </div>
                    <div class="col-6 mb-3">
                        <label class="form-label" for="VoucherCode">@T["Voucher code (optional)"]</label>
                        <input class="form-control" id="VoucherCode" name="VoucherCode" value="@Model.Form.VoucherCode" maxlength="60" />
                    </div>
                </div>

                <label class="form-label fw-semibold">@T["Payment method"]</label>
                <div class="mb-3">
                    @foreach (var o in Model.PaymentOptions)
                    {
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="PaymentMethod" id="pm_@(o.Method.Replace(" ", ""))" value="@o.Method"
                                   checked="@(Model.Form.PaymentMethod == o.Method && o.Enabled)" disabled="@(!o.Enabled)" />
                            <label class="form-check-label @(o.Enabled ? "" : "text-muted")" for="pm_@(o.Method.Replace(" ", ""))">
                                @(o.Method == "COD" ? T["Cash on Delivery"].Value : o.Method)@(o.Enabled ? "" : " - " + T["unavailable"].Value)
                            </label>
                        </div>
                    }
                    @if (Model.PaymentOptions.Any(o => o.Method == "COD"))
                    {
                        <div class="form-text">@T["Cash on Delivery is allowed when the rounded total is at most 1,000,000 VND."]</div>
                    }
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-5">
            <div class="card card-body">
                <h5>@(Model.IsTourist ? T["Final Price Before Payment"] : T["Live Price Breakdown"])</h5>
                <partial name="_PriceBreakdown" model="Model.Pricing" />
                @if (Model.HeavyRain)
                {
                    <div class="small text-muted mt-2">@T["Heavy-rain flag is ON."]</div>
                }
                <div class="d-grid gap-2 mt-3">
                    <button class="btn btn-outline-secondary" type="submit" name="Submit" value="preview">@T["Recalculate"]</button>
                    <button class="btn btn-sb" type="submit" name="Submit" value="place">@T["Place Order"] - @Model.Pricing.Total.Vnd()</button>
                </div>
            </div>
        </div>
    </div>
</form>
