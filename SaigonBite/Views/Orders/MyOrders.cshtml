@using SaigonBite.Helpers
@using SaigonBite.Services
@using SaigonBite.ViewModels
@model List<OrderRowViewModel>
@{
    ViewData["Title"] = T["My Orders"].Value;
    ViewData["Active"] = "My Orders";
}

<h2 class="h4 mb-3">@T["My Orders"]</h2>
<partial name="_Flash" />

<form method="get" asp-action="MyOrders" class="row g-2 mb-3">
    <div class="col-12 col-md-4">
        <label class="form-label" for="status">@T["Order status"]</label>
        <select class="form-select" id="status" name="status">
            <option value="">@T["All statuses"]</option>
            @foreach (var s in OrderStatus.All)
            {
                <option value="@s" selected="@((string?)ViewBag.Status == s)">@T[s]</option>
            }
        </select>
    </div>
    <div class="col-6 col-md-3">
        <label class="form-label" for="from">@T["From"]</label>
        <input class="form-control" type="date" id="from" name="from" value="@(((DateTime?)ViewBag.From)?.ToString("yyyy-MM-dd"))" />
    </div>
    <div class="col-6 col-md-3">
        <label class="form-label" for="to">@T["To"]</label>
        <input class="form-control" type="date" id="to" name="to" value="@(((DateTime?)ViewBag.To)?.ToString("yyyy-MM-dd"))" />
    </div>
    <div class="col-12 col-md-2 d-flex align-items-end">
        <button class="btn btn-outline-secondary w-100" type="submit">@T["Filter"]</button>
    </div>
</form>

<div class="table-responsive">
    <table class="table align-middle">
        <thead>
            <tr>
                <th>@T["Order ID"]</th><th>@T["Placed at"]</th><th class="text-end">@T["Total"]</th>
                <th>@T["Status"]</th><th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var o in Model)
        {
            <tr>
                <td class="fw-semibold">@o.Label</td>
                <td>@o.PlacedAt.When()</td>
                <td class="text-end">@o.Total.Vnd()</td>
                <td><span class="badge @OrderStatus.Badge(o.Status)">@T[o.Status]</span></td>
                <td>
                    <a asp-action="Details" asp-route-id="@o.OrderId">@T["View"]</a>
                    @if (o.Status == OrderStatus.Placed)
                    {
                        <span> / </span><a asp-action="Edit" asp-route-id="@o.OrderId">@T["Edit"]</a>
                    }
                    @if (o.Status == OrderStatus.Placed || o.Status == OrderStatus.Confirmed)
                    {
                        <span> / </span><a asp-action="Cancel" asp-route-id="@o.OrderId">@T["Cancel"]</a>
                    }
                </td>
            </tr>
        }
        @if (Model.Count == 0)
        {
            <tr><td colspan="5" class="text-muted">@T["No orders found."]</td></tr>
        }
        </tbody>
    </table>
</div>
