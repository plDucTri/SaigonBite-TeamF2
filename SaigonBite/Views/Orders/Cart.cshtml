@using SaigonBite.Helpers
@using SaigonBite.ViewModels
@model CartViewModel
@{
    ViewData["Title"] = T["Your Cart"].Value;
    ViewData["Active"] = "Your Cart";
}

<h2 class="h4 mb-3">@T["Your Cart"]</h2>
<partial name="_Flash" />

@if (Model.Lines.Count == 0)
{
    <div class="alert alert-info">@T["Your cart is empty."]</div>
    <a class="btn btn-sb" asp-action="Menu">@T["Browse Menu"]</a>
    return;
}

<div class="row g-3">
    <div class="col-12 col-lg-8">
        <div class="card card-body">
            <p class="text-muted">@T["Selected hub: {0}. All items must belong to this hub.", Model.HubName]</p>
            <form method="post" asp-action="UpdateCart" id="cartForm"></form>
            <form method="post" asp-action="RemoveFromCart" id="removeForm"></form>
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th></th><th>@T["Menu item"]</th><th class="text-end">@T["Unit price"]</th>
                            <th style="width:110px">@T["Quantity"]</th><th class="text-end">@T["Line total"]</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var l in Model.Lines)
                    {
                        <tr>
                            <td><input type="checkbox" form="removeForm" name="selected" value="@l.ItemId" aria-label="@T["Remove Selected Item"]" /></td>
                            <td class="fw-semibold">@l.Name</td>
                            <td class="text-end">@l.UnitPrice.Vnd()</td>
                            <td><input type="number" form="cartForm" name="qty[@l.ItemId]" value="@l.Quantity" min="0" max="20" class="form-control form-control-sm" /></td>
                            <td class="text-end">@l.LineTotal.Vnd()</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <button class="btn btn-outline-secondary" type="submit" form="cartForm">@T["Update Quantities"]</button>
                <button class="btn btn-outline-danger" type="submit" form="removeForm">@T["Remove Selected Item"]</button>
                <a class="btn btn-link" asp-action="Menu" asp-route-hubId="@Model.HubId">@T["Add more items"]</a>
            </div>
        </div>
    </div>
    <div class="col-12 col-lg-4">
        <div class="card card-body">
            <h5>@T["Cart Summary"]</h5>
            <div class="d-flex justify-content-between"><span>@T["Food subtotal (S)"]</span><strong>@Model.Subtotal.Vnd()</strong></div>
            <div class="d-flex justify-content-between"><span>@T["Hub load"]</span><span>@Model.HubLoadPct.Pct()</span></div>
            <div class="d-flex justify-content-between"><span>@T["Items"]</span><span>@Model.Lines.Count</span></div>
            <div class="alert alert-success small mt-3 mb-3">@T["Minimum food order: 50,000 VND. Choose available items only."]</div>
            <a class="btn btn-sb" asp-action="Checkout">@T["Continue to Checkout"]</a>
        </div>
    </div>
</div>
