@using SaigonBite.ViewModels
@model SimulationViewModel
@{
    ViewData["Title"] = T["Heavy Rain Flag"].Value;
    ViewData["Active"] = "Heavy Rain Flag";
}

<h2 class="h4 mb-3">@T["Heavy Rain Flag"]</h2>
<partial name="_Flash" />

<form method="post" asp-action="Simulation" class="card card-body">
    <div class="form-check form-switch mb-3">
        <input class="form-check-input" type="checkbox" role="switch" id="heavyRain" name="heavyRain" value="true" checked="@Model.HeavyRain" />
        <label class="form-check-label" for="heavyRain">@T["Heavy-rain flag (a 10,000 VND surcharge on new orders)"]</label>
    </div>
    <p class="text-muted small">@T["The value in force when an order is placed is saved with the order. Orders already placed keep their own value."]</p>

    <hr />

    <div class="form-check form-switch mb-3">
        <input class="form-check-input" type="checkbox" role="switch" id="gatewayDeclines" name="gatewayDeclines" value="true" checked="@Model.GatewayDeclines" />
        <label class="form-check-label" for="gatewayDeclines">@T["Mock payment gateway declines online payments (for the demo)"]</label>
    </div>
    <p class="text-muted small">@T["While this is on, MoMo, VNPay, Apple Pay and PayPal fail and no order is created. Cash on Delivery is not affected."]</p>

    <div><button class="btn btn-sb" type="submit">@T["Save"]</button></div>
</form>
